# Embeds a binary file as a hidden C array <NAME>_data with its size <NAME>_size:
#   cmake -DIN=<metallib> -DOUT=<c file> [-DNAME=<symbol prefix>] -P EmbedMetallib.cmake
# NAME defaults to sm_metallib, the library every GPU route loads.
if(NOT DEFINED NAME)
  set(NAME sm_metallib)
endif()
file(READ ${IN} _hex HEX)
string(LENGTH ${_hex} _hexlen)
math(EXPR _bytes "${_hexlen} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _array ${_hex})
file(WRITE ${OUT}
"/* Generated by cmake/EmbedMetallib.cmake: the metal-arrow kernel library (${_bytes} bytes). */
#include <stddef.h>
__attribute__((visibility(\"hidden\"))) const unsigned char ${NAME}_data[] = {${_array}};
__attribute__((visibility(\"hidden\"))) const size_t ${NAME}_size = sizeof(${NAME}_data);
")
